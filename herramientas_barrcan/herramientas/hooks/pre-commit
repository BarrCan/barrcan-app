#!/usr/bin/env bash
# ══════════════════════════════════════════════════════════════
# BarrCan · Guardián de versiones (se ejecuta solo antes de cada commit)
# Bloquea los 4 errores que más tiempo han costado:
#   1) Subir una copia VIEJA encima de una más nueva.
#   2) Cambiar un archivo sin subirle la versión.
#   3) Encabezado y versión en pantalla (APP_VERSION) que no coinciden.
#   4) Subir un archivo con la versión en el nombre (compras_v1.22.html).
# Para saltarlo en un caso excepcional:  git commit --no-verify
# ══════════════════════════════════════════════════════════════
fallas=0
encabezado_de() { grep -m1 -oE "VERSI(O|Ó)N[[:space:]]*:[[:space:]]*v[0-9][0-9.]*" | grep -oE "v[0-9][0-9.]*$"; }
badge_de()      { grep -m1 -oE "APP_VERSION[[:space:]]*=[[:space:]]*['\"]v[0-9][0-9.]*" | grep -oE "v[0-9][0-9.]*$"; }
sw_de()         { grep -m1 -oE "Service Worker v[0-9][0-9.]*" | grep -oE "v[0-9][0-9.]*$"; }
version_de() {
  local c="$1" v
  v=$(printf '%s' "$c" | encabezado_de); [ -n "$v" ] && { echo "$v"; return; }
  v=$(printf '%s' "$c" | sw_de);         [ -n "$v" ] && { echo "$v"; return; }
  printf '%s' "$c" | badge_de
}
es_mayor() { [ "$1" != "$2" ] && [ "$(printf '%s\n%s\n' "$1" "$2" | sort -V | tail -1)" = "$1" ]; }

while IFS= read -r f; do
  case "$f" in *.html|*.js) ;; *) continue ;; esac
  base=$(basename "$f")
  if printf '%s' "$base" | grep -qE '_v[0-9]'; then
    echo "❌ $f — el nombre trae versión. Debe llamarse como el módulo real (sin _vX)."; fallas=1; continue
  fi
  nuevo=$(git show ":$f" 2>/dev/null) || continue
  vn=$(version_de "$nuevo")
  enc=$(printf '%s' "$nuevo" | encabezado_de); bad=$(printf '%s' "$nuevo" | badge_de)
  if [ -n "$enc" ] && [ -n "$bad" ] && [ "$enc" != "$bad" ]; then
    echo "❌ $f — el encabezado dice $enc pero en pantalla (APP_VERSION) dice $bad."; fallas=1
  fi
  viejo=$(git show "HEAD:$f" 2>/dev/null) || continue      # archivo nuevo en el repo: OK
  vv=$(version_de "$viejo")
  { [ -z "$vn" ] || [ -z "$vv" ]; } && continue
  if es_mayor "$vv" "$vn"; then
    echo "❌ $f — intentas subir $vn pero GitHub ya tiene $vv (MÁS NUEVA). Es una copia vieja."; fallas=1
  elif [ "$vv" = "$vn" ]; then
    echo "❌ $f — cambió el contenido pero sigue en $vn. Súbele la versión."; fallas=1
  fi
done < <(git diff --cached --name-only --diff-filter=AM)

if [ $fallas -ne 0 ]; then
  echo ""; echo "⛔ Commit detenido. Nada se subió. Corrige lo de arriba y vuelve a intentar."
  exit 1
fi
exit 0
